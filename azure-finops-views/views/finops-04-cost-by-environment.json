{
  "properties": {
    "displayName": "FinOps 04 \u00b7 Cost by environment (prod vs non-prod, MTD)",
    "chart": "StackedColumn",
    "metric": "AmortizedCost",
    "accumulated": "false",
    "kpis": [
      {
        "type": "Forecast",
        "enabled": true,
        "id": null
      },
      {
        "type": "Budget",
        "enabled": true,
        "id": "__BUDGET_ID__"
      }
    ],
    "pivots": [
      {
        "type": "TagKey",
        "name": "__APP_TAG__"
      },
      {
        "type": "Dimension",
